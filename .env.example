# Copy this file to ".env" and fill in your own values. ".env" is ignored by git - never commit it.
# Full instructions: docs/GOOGLE_LOGIN.md

# --- Google sign-in (leave empty to run the app open, with no login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may sign in. Empty = any Google account.
#ALLOWED_EMAILS=you@gmail.com,friend@gmail.com
#ALLOWED_EMAIL_DOMAINS=mycompany.com

# --- Deployment (optional) ---
#PUBLIC_BASE_URL=https://dehaze.example.com
#TRUST_PROXY=1
#HOST=127.0.0.1
#PORT=5000
#DATA_TTL_HOURS=24
#MAX_IMAGES=10
#MAX_UPLOAD_MB=100

# --- Performance (optional) ---
# Run the dehazing network in full fp32 instead of the default fp16 on GPU (about 1.7x slower, bit-exact).
#IPC_FP32=1
